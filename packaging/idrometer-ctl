#!/bin/sh
# Run an idrometer command as the service user with the service's settings.
#   idrometer-ctl admin set-password
#   idrometer-ctl backup --out /var/lib/idrometer/manual.db
# Running idrometer directly as root would create root-owned database files
# that the service cannot write, so use this wrapper instead.
set -eu
umask 077  # database and backups hold the password hash

if [ "$(id -u)" -ne 0 ]; then
    echo "idrometer-ctl: run as root (try: sudo idrometer-ctl $*)" >&2
    exit 1
fi
set -a
# shellcheck disable=SC1091
. /etc/idrometer/idrometer.env
set +a
exec runuser -u idrometer -- /usr/bin/idrometer "$@"
