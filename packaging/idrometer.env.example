# idrometer configuration. Apply changes with: systemctl restart idrometer
# Values are read by systemd and by idrometer-ctl: keep them simple, no spaces.

# Address and port to listen on. Ports below 1024 need a reverse proxy.
IDROMETER_LISTEN=:8080

# SQLite database. Backups go to a "backups" folder beside it.
IDROMETER_DB_PATH=/var/lib/idrometer/idrometer.db

# Secret your iSpindel sends with every report (16+ characters).
IDROMETER_INGEST_TOKEN=@TOKEN@

# debug, info, warn or error
IDROMETER_LOG_LEVEL=info

# Set to true when the web UI is served over HTTPS (for example behind a
# reverse proxy). The iSpindel itself can only speak plain HTTP.
#IDROMETER_SECURE_COOKIES=true

# Scheduled database snapshots: how often (1h or more, or "off") and how many to keep.
#IDROMETER_BACKUP_INTERVAL=24h
#IDROMETER_BACKUP_KEEP=7
#IDROMETER_BACKUP_DIR=/var/lib/idrometer/backups

# How often devices that went silent are checked.
#IDROMETER_SWEEP_INTERVAL=15m
